            "mode": "auto",
            "program": "${workspaceFolder}/cmd/integration-acoem/main.go",
            "env": {
                "ACOEM_BASEURL": "https://api.acoemuk.net",
                "CONTEXT_BROKER_URL": "http://localhost:1026",
                //"ACOEM_ACCOUNT_ID": "",
                //"ACOEM_ACCOUNT_KEY": ""
